# Public (browser + Edge). Copy to `.env.local`; set the same keys on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site URL for Stripe redirects (production). Optional locally—defaults to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to the client or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Checkout (required). Copy from prices.csv / vercel-stripe-from-csv.env in repo.
STRIPE_PRICE_TRIBUTE=price_1TU9sUE6oTidvpnU68kvcOKw
STRIPE_PRICE_LEGACY=price_1TU9sVE6oTidvpnUB9oFiXUi
STRIPE_PRICE_HERITAGE=price_1TU9sVE6oTidvpnUIqfvudIY

# Product IDs from products.csv (optional).
STRIPE_PRODUCT_MEMORYMINT_TRIBUTE=prod_UT646h44yq9bWn
STRIPE_PRODUCT_MEMORYMINT_LEGACY=prod_UT64SlrReSpYvJ
STRIPE_PRODUCT_MEMORYMINT_HERITAGE=prod_UT64La3ptAPp0V
STRIPE_PRODUCT_EXTRA_MEMORYMINT_CARD=prod_UT645cLGTNDCZD
STRIPE_PRODUCT_TRIBUTE_TO_LEGACY_UPGRADE=prod_UT64f5GAkEN00r
STRIPE_PRODUCT_TRIBUTE_TO_HERITAGE_UPGRADE=prod_UT64clKub31vJH

# Optional upsells (see prices.csv; wire in app when ready).
# STRIPE_PRICE_EXTRA_CARD=price_1TU9sXE6oTidvpnU7roMkBvD
